# Engine credentials now live outside the repository.
#
# Copy this file to the per-user credential location, or run:
#   node scripts/install-credentials.mjs --remove-legacy
#
#   Windows: %APPDATA%\agent-workbench\credentials\engine.env
#   POSIX:   ~/.config/agent-workbench/credentials/engine.env
#
# The repository copy (workbench.env) is only a one-version migration fallback
# and must not be used for new installations.

MCP_BEARER_TOKEN=replace-with-at-least-32-random-characters
MCP_PORT=8080
# Listen address. Local default is 127.0.0.1; containers use 0.0.0.0.
# MCP_BIND=127.0.0.1
MAX_PARALLEL_TASKS=4
WORKBENCH_DSH_MAX_PARALLEL_TASKS=2
TASK_TIMEOUT_MS=1800000
STALE_AFTER_MS=600000
HEARTBEAT_MS=15000
RATE_LIMIT_PER_MIN=600

# ---------------------------------------------------------------------------
# P0 identity isolation
# ---------------------------------------------------------------------------
# Human and Muse principals are derived from MCP_BEARER_TOKEN unless set here.
# Rotate them independently by providing explicit values:
# MCP_HUMAN_TOKEN=...
# MCP_MUSE_TOKEN=...
#
# Legacy master token (MCP_BEARER_TOKEN) is accepted for one compatibility
# version as a human principal (from=user only). Set to 0 to revoke it once the
# GUI uses MCP_HUMAN_TOKEN. Rollback: set MCP_BEARER_TOKEN back and leave this
# at 1.
# WORKBENCH_LEGACY_MASTER=1
# Allow the legacy master to post as muse again (rollback only):
# WORKBENCH_LEGACY_MASTER_ALLOW_MUSE=0
#
# Static per-agent tokens are accepted for one compatibility version so old
# verify scripts still run. New tasks receive signed, task-bound, expiring
# tokens. Set to 0 to reject static tokens.
# WORKBENCH_LEGACY_AGENT_TOKENS=1
#
# The human token cannot start tasks or dispatch by default. Set to 1 to let
# the GUI use the human token for task_start/task_send.
# WORKBENCH_HUMAN_OPERATE=0
#
# Muse must poll or call muse_heartbeat within this lease before writing.
MUSE_REQUIRE_HEARTBEAT=1
MUSE_LEASE_TTL_MS=300000
# Per-task executor token lifetime ceiling (also bounded by task timeout).
AGENT_TOKEN_TTL_MS=7200000
#
# Executors run in this workspace, not in the repository root. It must not
# contain credentials. Master may still pass an explicit cwd to task_start.
# WORKBENCH_WORKSPACE_DIR=workspace

# Chat-based approval gate for merge / delete / dependency operations.
# Off by default: the workbench stays fully automatic. Set to 1 to enable.
# AGENT_APPROVAL_GATE=0
# APPROVAL_TIMEOUT_MS=600000
# Optional executable overrides:
# WORKBENCH_CLAUDE_BIN=claude
# WORKBENCH_DSH_BIN=dsh

# Container credential options (placeholders; see docs/CLOADY_DEPLOY.md).
# Set these in the platform's environment/secret panel, not in this file.
# WORKBENCH_CLAUDE_SETTINGS=/path/to/settings.json
# WORKBENCH_CLAUDE_ENV_JSON={"ANTHROPIC_BASE_URL":"https://your-gateway.example/anthropic","ANTHROPIC_AUTH_TOKEN":"replace-with-your-token"}
# DSH_CREDENTIALS_YAML=BAILIAN_API_KEY: replace-me
# DSH_HEADLESS_PATCH_YAML=[]