MCP_BEARER_TOKEN=replace-with-at-least-32-random-characters
MCP_PORT=8080
# Listen address. Local default is 127.0.0.1; containers use 0.0.0.0.
# MCP_BIND=127.0.0.1
MAX_PARALLEL_TASKS=4
WORKBENCH_DSH_MAX_PARALLEL_TASKS=2
TASK_TIMEOUT_MS=1800000
STALE_AFTER_MS=600000
HEARTBEAT_MS=15000
RATE_LIMIT_PER_MIN=600
# Chat-based approval gate for merge / delete / dependency operations.
# Off by default: the workbench stays fully automatic. Set to 1 to enable.
# AGENT_APPROVAL_GATE=0
# APPROVAL_TIMEOUT_MS=600000
# Optional executable overrides:
# WORKBENCH_CLAUDE_BIN=claude
# WORKBENCH_DSH_BIN=dsh

# Container credential options (placeholders; see docs/CLOADY_DEPLOY.md).
# Set these in the platform's environment/secret panel, not in this file.
# WORKBENCH_CLAUDE_SETTINGS=/path/to/settings.json
# WORKBENCH_CLAUDE_ENV_JSON={"ANTHROPIC_BASE_URL":"https://your-gateway.example/anthropic","ANTHROPIC_AUTH_TOKEN":"replace-with-your-token"}
# DSH_CREDENTIALS_YAML=BAILIAN_API_KEY: replace-me
# DSH_HEADLESS_PATCH_YAML=[]
