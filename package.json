{
  "name": "agent-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Local MCP server that lets a cloud orchestrator dispatch tasks to Claude Code and DeepSeek Harness on this Windows machine.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/*.test.js\"",
    "verify:upgrade": "node scripts/verify-upgrade.mjs",
    "typecheck": "node scripts/check-syntax.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "cross-spawn": "^7.0.6"
  }
}
